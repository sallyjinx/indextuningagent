# Copy to .env locally, edit, then: set -a; source .env; set +a
# Never submit .env or real keys. Use exactly one database startup option.
PG_DSN='host=127.0.0.1 port=55432 dbname=index_agent user=agent password=CHANGE_ME'
AGENT_DB_PASSWORD='CHANGE_ME'
AGENT_DB_PORT=55432
# Set only when creating a new local cluster whose shared buffers should differ.
# AGENT_PG_SHARED_BUFFERS=4MB
# Local private cluster alternative:
# PG_DSN='host=/absolute/path/IndexTuningAgent/.local/pg16-socket port=55432 dbname=index_agent user=agent'
MODEL_BASE_URL='https://api.deepseek.com'
MODEL_NAME='deepseek-flash'
MODEL_API_KEY=''
MODEL_TIMEOUT_SECONDS=60
MODEL_CONNECT_TIMEOUT_SECONDS=10
# Pace request starts to stay below provider requests/tokens-per-minute limits.
MODEL_MIN_REQUEST_INTERVAL_SECONDS=15
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=400
MODEL_TOKEN_LIMIT_PARAMETER=max_tokens
# DeepSeek needs explicit disabled mode for this short structured answer.
# For other OpenAI-compatible servers use omit unless they support this field.
MODEL_THINKING=disabled
